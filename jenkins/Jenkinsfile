pipeline {
  agent any

  environment {
    COMPOSE_PROJECT_NAME = 'devops-learn-ci'
    COMPOSE_PATH= 'docker/compose-lab/docker-compose.yml'
  }

  stages {
    stage('Checkout Code') {
      steps {
        checkout scm
      }
    }

    stage('Lint / Validate') {
      steps {
        echo 'Validating Docker Compose configuration...'
        sh 'docker compose -f ${COMPOSE_PATH} config'
      }
    }

    stage('Build Containers') {
      steps {
        echo 'Building 3-tier application images...'
        // Builds your nginx, backend, and database containers.
        sh 'DB_USER=myuser DB_NAME=my-postgres-db DB_PASSWORD=${DB_PASSWORD} docker compose -f ${COMPOSE_PATH} build'
      }
    }

    stage('Run Tests') {
      steps {
        withCredentials([string(credentialsId: 'db-password', variable: 'DB_PASSWORD')]){
          echo 'Running backend unit test...'
          sh 'DB_USER=myuser DB_NAME=my-postgres-db DB_PASSWORD=${DB_PASSWORD} docker compose -f ${COMPOSE_PATH} run --rm backend python -m pytest'
        }
      }
    }

    stage('Push Images') {
      steps {
        withCredentials([string(credentialsId: 'dockerhub-token', variable: 'DOCKER_PASSWORD')]) {
          sh "docker login -u 'ikhsankusuma97' -p '${DOCKER_PASSWORD}'"
          sh "docker compose -f ${COMPOSE_PATH} push"
        }
      }
    }

    stage('Deploy Stage') {
      steps {
        withCredentials([string(credentialsId: 'db-password', variable: 'DB_PASSWORD')]){
          echo "Deploying 3-tier application stack..."
          sh "DB_USER=myuser DB_NAME=my-postgres-db DB_PASSWORD=${DB_PASSWORD} docker compose -f ${COMPOSE_PATH} up -d --build"
        }
      }
    }
  }

  post {
    always {
      echo 'cleaning up dangling Docker build cache...'
      sh 'docker system prune -f --volumes'
    }
    success {
      echo 'Pipeline completed successfully!'
    }
    failure {
      echo 'Pipeline failed. Check logs above for details.'
    }
  }
}
